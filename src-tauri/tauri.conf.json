{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vjai",
  "version": "0.1.0",
  "identifier": "com.azylume.vjai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vjai",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/Volumes/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Video",
    "publisher": "Azylume",
    "copyright": "Copyright (c) 2026 Azylume",
    "shortDescription": "Live visuals, mapped and modulated.",
    "longDescription": "vjai is a VJ instrument: layered WebGL2 sources and effects, projection mapping with edge blending, audio-reactive modulation and a chat agent that edits the show while it runs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
